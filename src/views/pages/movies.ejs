<%- include("../partials/header", { title }) %>
<section class="page-banner">
  <div class="container">
    <span class="eyebrow">THE COLLECTION</span>
    <h1>Explore movies</h1>
    <p>There's always another story waiting to be discovered.</p>
  </div>
</section>
<section class="section container">
  <form class="filter-bar" action="/movies" method="GET">
    <label class="search-box"><span aria-hidden="true">⌕</span><input type="search" name="search" value="<%= search %>" placeholder="Search movie titles..." aria-label="Search movie titles"></label>
    <label class="genre-select"><span class="sr-only">Filter by genre</span>
      <select name="genre">
        <option value="">All genres</option>
        <% genres.forEach((genre) => { %>
          <option value="<%= genre %>" <%= selectedGenre === genre ? "selected" : "" %>><%= genre %></option>
        <% }) %>
      </select>
    </label>
    <button class="button button-primary" type="submit">Search</button>
    <% if (search || selectedGenre) { %><a class="clear-link" href="/movies">Clear</a><% } %>
  </form>
  <div class="results-line"><span><strong><%= movies.length %></strong> movies found</span></div>
  <% if (movies.length) { %>
    <div class="movie-grid">
      <% movies.forEach((movie) => { %>
        <%- include("../partials/movie-card", { movie }) %>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state"><h3>No matches found</h3><p>Try another title or choose a different genre.</p><a class="button button-secondary" href="/movies">Show all movies</a></div>
  <% } %>
</section>
<%- include("../partials/footer") %>
