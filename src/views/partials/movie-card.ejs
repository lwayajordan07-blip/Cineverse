<article class="movie-card">
  <a class="poster-link" href="/movies/<%= movie.id %>" aria-label="View details for <%= movie.title %>">
    <img class="movie-poster" src="<%= movie.poster_url %>" alt="Poster for <%= movie.title %>" loading="lazy"
         onerror="this.onerror=null;this.src='https://placehold.co/400x600/171b2b/f4f5fb?text=No+Poster';">
    <span class="rating-pill">★ <%= Number(movie.rating).toFixed(1) %></span>
  </a>
  <div class="movie-card-info">
    <h3><a href="/movies/<%= movie.id %>"><%= movie.title %></a></h3>
    <p><%= movie.release_year %> <span aria-hidden="true">·</span> <%= movie.genre %></p>
  </div>
</article>
